	email = nathan.smith@elastic.co
	name = Nathan L Smith
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAeMFlrtsME0bcNbkiiQZgFdMNRD69ordSCWtj3pyuoI
[github]
	user = smith
[alias]
  d = commit . -m "duh" --no-verify
  disable-upstream-push = remote set-url --push upstream push_disabled
  br = branch
  ci = commit
  co = checkout
  di = diff
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  pr = 
  st = status
  sta = stash
  standup = log --since yesterday --author='Nathan L Smith' --pretty=oneline --branches=* --decorate
	up = pull --rebase --autostash
[branch]
  autosetupmerge = true
  autosetuprebase = always
[color]
  branch = auto
  diff = auto
  status = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[core]
	excludesfile = ~/.gitignore
	ignorecase = false
	symlinks = false
[push]
	autoSetupRemote = true
	default = simple
[filter "media"]
	clean = git media clean %f
	smudge = git media smudge %f
	required = true
[commit]
	gpgsign = true
[branch "master"]
#	pushRemote = no_push
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[init]
	defaultBranch = main
